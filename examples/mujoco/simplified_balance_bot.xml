<mujoco>
	<option gravity="0 0 -9.81" integrator="implicitfast"/>
    <default>
        <geom type="box" size="0.075 0.035 0.005" rgba="1 1 1 1"/>
    </default>

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
        <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.6"/>
    </asset>

    <worldbody>
		<light diffuse=".5 .5 .5" pos="0 0 10" dir="0 0 -1"/>
        <geom name="floor" type="plane" size=".9 .9 0.01" material="grid"/>
        <body name="balance_bot" pos="0 0 0.18">
            <freejoint/>
            <geom name="top_plate" mass="0.6392"/>
            <body>
                <geom name="left_leg" euler="0 90 0" pos="0.078 0 -0.070"/>
                <body name="wheel_l">
                    <joint name="wheel_l_joint" type="hinge" axis="1 0 0" pos="0.095 0.005 -0.13"/>
                    <geom name="wheel_l" type="cylinder"  size="0.05 0.01" rgba="0 0 0 1" euler="0 90 0" pos="0.095 0.005 -0.13"/>
                </body>
            </body>
            <body>
                <geom name="right_leg" euler="0 90 0" pos="-0.078 0 -0.070"/>
                <body name="wheel_r">
                    <joint name="wheel_r_joint" type="hinge" axis="1 0 0" pos="-0.095 0.005 -0.13"/>
                    <geom name="wheel_r" type="cylinder"  size="0.05 0.01" rgba="0 0 0 1" euler="0 -90 0" pos="-0.095 0.005 -0.13"/>
                </body>
            </body>
            <site name="imu" pos="0 0.03 0.005" type="box" size="0.003 0.003 0.001" rgba="0 0 1 1"/>
        </body>
    </worldbody>

    <actuator>
        <motor joint="wheel_l_joint" ctrlrange="-1 1" ctrllimited="true"/>
        <motor joint="wheel_r_joint" ctrlrange="-1 1" ctrllimited="true"/>
    </actuator>

    <sensor>
        <gyro name="imu_gyro" site="imu"/>
        <accelerometer name="imu_accel" site="imu"/>
        <jointpos name="left_wheel_pos" joint="wheel_l_joint"/>
        <jointpos name="right_wheel_pos" joint="wheel_r_joint"/>
        <jointvel name="left_wheel_vel" joint="wheel_l_joint"/>
        <jointvel name="right_wheel_vel" joint="wheel_r_joint"/>
    </sensor>

</mujoco>
